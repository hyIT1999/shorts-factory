# Shorts Factory environment variables.
# Copy to .env and fill in values. Never commit .env.

# SQLite database file (relative to the project root)
DATABASE_URL="file:./data/shorts-factory.db"

# API server port
PORT=3000

# --- Future provider credentials (unused in STEP 1) ---
# Server/worker side only. Never expose these to the Angular frontend.
AI_API_KEY=
PEXELS_API_KEY=
TTS_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
