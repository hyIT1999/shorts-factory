# Shorts Factory environment variables.
# Copy to .env and fill in values. Never commit .env.

# SQLite database file (relative to the project root)
DATABASE_URL="file:./data/shorts-factory.db"

# API server port and bind address. 127.0.0.1 keeps the API private to this machine (Angular dev
# proxy, SSH tunnel, or nginx in front of it). Use 0.0.0.0 only together with API_TOKEN or an
# authenticating reverse proxy: without either, anyone who reaches the port can spend your AI quota.
PORT=3000
HOST=127.0.0.1
# Optional shared secret (at least 16 characters, e.g. `openssl rand -hex 24`). When set, every /api
# request except /api/health must send it as "Authorization: Bearer <token>" or "X-API-Key: <token>";
# paste it into Settings → API token in the app. Leave empty on a private machine.
API_TOKEN=
# Mutating requests (POST/PUT/DELETE) allowed per client per minute; 0 disables the limit
RATE_LIMIT_PER_MINUTE=30
# /api/health reports "degraded" below this much free space on DATA_DIR (MB)
HEALTH_MIN_FREE_MB=5120
# `npm run data:sweep` removes the files of video versions that are not the latest of their project
# and older than this many days (the latest version is never touched)
DATA_RETENTION_DAYS=30

# --- AI (server/worker side only; never exposed to the Angular frontend) ---
# "gemini", "openai" (default when unset) or "mock" (deterministic fixtures, no API calls / no credits)
AI_PROVIDER=gemini

# Gemini (AI_PROVIDER=gemini). Model must support structured output (JSON schema).
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI (AI_PROVIDER=openai). Model must support structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Assets (scene visuals) ---
# "placeholder" (default: generated 1080x1920 PNG, offline, free), "mock" (tests/dev) or
# "pexels" (stock photos; needs PEXELS_API_KEY from https://www.pexels.com/api/ — free plan: 200 requests/hour)
ASSET_PROVIDER=placeholder
PEXELS_API_KEY=
# A scene without a usable stock photo gets a "placeholder" image (default, marked fallback in the
# asset metadata) or makes the job "fail" (re-run ASSETS later, e.g. once the hourly limit resets)
# ASSET_FALLBACK=placeholder
# Photos requested per search (1-80, default 15); the best 5 are tried in order (untried ones are dropped once one is stored)
# ASSET_SEARCH_LIMIT=15
# Images larger than 1080x1920 are re-encoded to a 1080x1920 JPEG with ffmpeg (FFMPEG_PATH); time limit per image
# ASSET_NORMALIZE_TIMEOUT_MS=60000
# Storage root for generated/downloaded files (default: data). The DB stores paths relative to it.
# DATA_DIR=data

# --- Voice (narration TTS; one WAV per scene on disk) ---
# "gemini" (default; uses GEMINI_API_KEY), "silent" (offline dev/tests) or "mock" (tests)
VOICE_PROVIDER=gemini
# Gemini TTS model and prebuilt voice name (see the Gemini speech-generation docs)
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# "narration" (default): ONE TTS request per video, the audio is then cut into the per-scene WAVs at the
# pauses (the Gemini free tier allows ~10 TTS requests/day/model, i.e. ~10 videos/day this way).
# "scene": one request per scene, sequentially (~1 video/day on the free tier).
# VOICE_MODE=narration
# Time limit for one TTS request in ms (default 300000 = 5 minutes; a whole narration takes a while)
# VOICE_TIMEOUT_MS=300000
# Scene mode only: pause between TTS requests in ms (2000 keeps the Gemini free tier happy)
VOICE_REQUEST_DELAY_MS=2000

# --- Render (FFmpeg: scene images + narration + burned-in subtitles → MP4) ---
# "ffmpeg" (default) or "mock" (tests only: validates inputs, writes no video; never an automatic fallback)
RENDER_PROVIDER=ffmpeg
# Full paths to ffmpeg.exe / ffprobe.exe (a "full"/"gpl" build with libx264 + libass).
# Empty = use "ffmpeg" / "ffprobe" from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Stop FFmpeg after this many ms (default 600000 = 10 minutes)
RENDER_TIMEOUT_MS=600000
# Folder containing BeVietnamPro-Bold.ttf (default: templates/documentary/fonts, relative to the project root)
# RENDER_FONTS_DIR=templates/documentary/fonts
# Encoder threads for libx264 (default 0 = all cores; lower it when the machine is shared)
# RENDER_THREADS=0
# Ken Burns motion on the scene images: "kenburns" (default: a slow zoom or pan per scene) or "off" (still images)
# RENDER_MOTION=kenburns
# Supersampling before zoompan, 1-3 (default 2: smooth pans, ~3-4x the still-image render time; 1 is ~2x faster)
# RENDER_MOTION_SCALE=2
# Force one preset for every scene: auto (default), zoom-in, zoom-out, pan-left, pan-right, pan-up, pan-down
# RENDER_MOTION_PRESET=auto

# --- Future provider credentials (unused yet) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# Worker idle polling interval in milliseconds (default 1000)
# WORKER_POLL_INTERVAL_MS=1000

# --- Reliability (defaults shown; leave commented out unless you need to change them) ---
# Retries for transient AI/TTS failures (HTTP 429, 5xx, timeouts, network errors):
# total attempts including the first request, first delay, and the cap for one delay
# (each retry waits 3x longer; a Retry-After hint from the provider wins).
# PROVIDER_RETRY_ATTEMPTS=4
# PROVIDER_RETRY_BASE_MS=5000
# PROVIDER_RETRY_MAX_MS=60000
# Heartbeat a worker sends while it runs a job, and how long a job may stay silent before another
# worker treats its worker as dead and recovers the job (back to PENDING, or FAILED after JOB_MAX_ATTEMPTS).
# JOB_HEARTBEAT_MS=15000
# JOB_STALE_MS=120000
# JOB_MAX_ATTEMPTS=3
# JOB_RECOVERY_INTERVAL_MS=60000
# On SIGINT/SIGTERM the worker kills ffmpeg, requeues its job and exits; this bounds the wait.
# WORKER_STOP_TIMEOUT_MS=30000
