{
  "name": "shorts-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Private single-user tool for producing short-form videos.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:frontend": "npm start --prefix frontend",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "npm run build --prefix frontend",
    "start": "node dist/server/index.js",
    "worker": "tsx workers/worker.ts",
    "lint": "eslint . && npm run lint --prefix frontend",
    "lint:server": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate && npm install --prefix frontend"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
